# Copy to .env to override. Every value below is the default.

# --- ports published by docker compose ---
FRONTEND_PORT=9063
BACKEND_PORT=8000

# --- synthetic world ---
SIM_SEED=42               # same seed -> same fleet, stations, routes and frames
FLEET_SIZE=1250           # simulated EVs
ADAS_FRAME_COUNT=5000     # mock driving frames
SIM_TICK_SECONDS=3        # real seconds between simulation ticks
SIM_SECONDS_PER_TICK=60   # simulated driving time per tick (time-lapse)

# --- backend (development mode only) ---
# DATA_DIR=./data         # where SQLite + CSV/JSON are written
# CORS_ORIGINS=*

# --- frontend (development mode only; read by Vite) ---
# VITE_BACKEND_URL=http://localhost:8000
# VITE_MAP_TILE_URL=      # optional natively-dark tile provider; default is OpenStreetMap
# VITE_MAP_ATTRIBUTION=
